{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "excel_to_vcf 디버그",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/excel_to_vcf.py",
            "args": [
                "고정/쉬프트"
            ],
            "console": "integratedTerminal"
		},
		{
			"name": "AutoHotkey Debug",
			"type": "autohotkey",
			"request": "launch",
			"program": "${file}",
			"args": []
		},
		{
			"name": "AutoHotkey Debug (Advanced Configuration)",
			"type": "autohotkey",
			"request": "launch",
			"program": "${file}",
			"args": [],
			"port": "9002-9010",
			"variableCategories": "recommend",
			"useDebugDirective": true,
			"useAutoJumpToError": true
		},
		{
			"type": "ahk",
			"request": "launch",
			"name": "AutoHotkey v1 Debugger",
			"program": "",
			"stopOnEntry": true
		},
		{
			"type": "ahk2",
			"request": "launch",
			"name": "AutoHotkey v2 Debugger",
			"program": "${file}",
			"stopOnEntry": true
		}
	]
}